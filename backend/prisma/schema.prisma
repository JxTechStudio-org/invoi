generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  processing
  completed
  needs_review
}

enum PaymentStatus {
  paid
  unpaid
  partially_paid
  overdue
}

enum PaymentMethod {
  bank_transfer
  credit_card
  cash
  cheque
  online_payment
  mixed
}

enum Currency {
  SAR
  USD
  AED
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  businessName          String
  firstName             String
  lastName              String
  username              String
  phone                 String
  reviewAmountThreshold Decimal?  @db.Decimal(12, 2)
  createdAt             DateTime  @default(now())
  invoices              Invoice[]
}

model Invoice {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fileUrl              String
  status               InvoiceStatus  @default(processing)
  vendorName           String?
  invoiceNumber        String?
  invoiceDate          DateTime?
  dueDate              DateTime?
  totalAmount          Decimal?       @db.Decimal(12, 2)
  taxAmount            Decimal?       @db.Decimal(12, 2)
  amountPaid           Decimal?       @db.Decimal(12, 2)
  currency             Currency?
  paymentStatus        PaymentStatus?
  paymentMethod        PaymentMethod?
  // Extracted document value; User.businessName remains the account identity.
  customerName         String?
  // Vendor tax number and vendor commercial registration number only.
  taxNumber            String?
  crNumber             String?
  extractionConfidence Json?
  needsReviewReason    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status])
  @@index([invoiceDate])
  @@index([userId])
}
