generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  processing
  completed
  needs_review
}

enum PaymentStatus {
  paid
  unpaid
  partially_paid
  overdue
}

enum PaymentMethod {
  bank_transfer
  credit_card
  cash
  cheque
  online_payment
  mixed
}

enum Currency {
  SAR
  USD
  AED
  EUR
  GBP
  KWD
  QAR
  BHD
  OMR
  EGP
  JOD
  CNY
  INR
}

enum JobState {
  queued
  running
  done
  failed
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  passwordHash          String
  businessName          String
  firstName             String
  lastName              String
  username              String
  phone                 String
  reviewAmountThreshold Decimal?      @db.Decimal(12, 2)
  // English trading name; the customer-name check compares against both names.
  businessNameEn        String?
  // The production demo account (seed:// invoices); excluded from extraction and scheduled runs.
  isDemo                Boolean       @default(false)
  createdAt             DateTime      @default(now())
  invoices              Invoice[]
  analysisJobs          AnalysisJob[]
}

model Invoice {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fileUrl              String
  status               InvoiceStatus   @default(processing)
  vendorName           String?
  invoiceNumber        String?
  invoiceDate          DateTime?
  dueDate              DateTime?
  totalAmount          Decimal?        @db.Decimal(12, 2)
  taxAmount            Decimal?        @db.Decimal(12, 2)
  amountPaid           Decimal?        @db.Decimal(12, 2)
  currency             Currency?
  paymentStatus        PaymentStatus?
  paymentMethod        PaymentMethod?
  // Extracted document value; User.businessName remains the account identity.
  customerName         String?
  // Vendor tax number and vendor commercial registration number only.
  taxNumber            String?
  crNumber             String?
  extractionConfidence Json?
  needsReviewReason    String?
  // Fields the user changed by hand; re-extraction never overwrites them.
  editedFields         String[]        @default([])
  extractionModel      String?
  extractionDurationMs Int?
  extractionCostUsd    Decimal?        @db.Decimal(10, 6)
  extractedAt          DateTime?
  // Real payment date (DPO); set when paymentStatus becomes paid.
  paidAt               DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  extractionJobs       ExtractionJob[]

  @@index([status])
  @@index([invoiceDate])
  @@index([userId])
}

model ExtractionJob {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  state     JobState @default(queued)
  attempts  Int      @default(0)
  runAfter  DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The worker claims the oldest due queued job.
  @@index([state, runAfter])
  @@index([invoiceId])
}

model AnalysisJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Analysis type from the n8n workflow list, e.g. dpo_aging.
  type      String
  state     JobState @default(queued)
  result    Json?
  costUsd   Decimal? @db.Decimal(10, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Latest result per user and type.
  @@index([userId, type, createdAt])
}
