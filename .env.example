POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=
NODE_ENV=
APP_URL=
VITE_API_BASE_URL=
STORAGE_DRIVER=rustfs
STORAGE_LOCAL_PATH=
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=invoices
RUSTFS_ACCESS_KEY=replace-with-a-unique-access-key
RUSTFS_SECRET_KEY=replace-with-a-strong-random-secret
RUSTFS_CONSOLE_HOST_PORT=9001
CORS_ALLOWED_ORIGINS=http://localhost:5173
# AI extraction (Phase 1). Off unless set to true; changes need an app restart.
EXTRACTION_ENABLED=false
# Comma-separated user IDs during rollout; empty means every account.
EXTRACTION_ACCOUNT_ALLOWLIST=
# Monthly AI spend cap in USD, shared with analytics.
EXTRACTION_MONTHLY_BUDGET_USD=2
# claude-sonnet-5-5 (default) or claude-haiku-5-5.
EXTRACTION_MODEL=claude-sonnet-5-5
# Anthropic API key; needed only when extraction is enabled. Keep it in /run/secrets/invoi.env.
ANTHROPIC_API_KEY=
